{
  "name": "blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/verify-build.mjs",
    "check:build": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "check:ports": "node scripts/check-ports.mjs",
    "backend:dev": "cd backend && npm run develop",
    "backend:seed": "node backend/scripts/seed.js",
    "essays:sync": "node backend/scripts/seed-local-content.mjs --essays-only",
    "tutorials:check": "node backend/scripts/seed-local-content.mjs --check-tutorials",
    "tutorials:sync": "node backend/scripts/seed-local-content.mjs --tutorials-only",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "ci": "pnpm install --frozen-lockfile && pnpm run typecheck && pnpm run test:run && pnpm build"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "dompurify": "3.4.16",
    "jszip": "3.10.1",
    "marked": "18.0.14",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.6.1"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
