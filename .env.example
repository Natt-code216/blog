# ============================
# 前端环境变量（Vite）
# 必须以 VITE_ 开头，否则不会暴露给客户端
# ============================

# Strapi 后端 API 地址
VITE_API_URL=http://localhost:1337/api

# ============================
# 后端环境变量请见 backend/.env.example
# 包括 APP_KEYS / API_TOKEN_SALT / ADMIN_JWT_SECRET 等
# ============================

# ============================
# 可选：种子脚本使用的 Token
# 在 Strapi Admin → Settings → API Tokens 生成 Full Access Token
# ============================
# STRAPI_TOKEN=
