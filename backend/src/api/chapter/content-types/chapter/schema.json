{
  "kind": "collectionType",
  "collectionName": "chapters",
  "info": {
    "singularName": "chapter",
    "pluralName": "chapters",
    "displayName": "Chapter"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "est_read_minutes": {
      "type": "integer"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "tutorial": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tutorial.tutorial",
      "inversedBy": "chapterList"
    }
  }
}
